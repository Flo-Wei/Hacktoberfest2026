# Copy this file to .env and fill in your keys. Never commit .env.

# Gemma, hosted through the Gemini API.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs.
# Create a key at https://elevenlabs.io/app/api/api-keys
ELEVENLABS_API_KEY=

# Lovable REST API. Optional, and only available on Business or Enterprise workspaces.
# The Lovable MCP server doesn't need this: it logs in through your browser.
# Create a key at https://lovable.dev/settings/api-keys
# Don't rename this to LOVABLE_API_KEY: Lovable reserves that name for project secrets.
LOV_PUBLIC_API_KEY=

# Host port for docker compose. Optional, defaults to 3000.
# WEB_PORT=3000
