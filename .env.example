# Copy this file to .env and fill in your keys. Never commit .env.

# Gemma, hosted through the Gemini API.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs.
# Create a key at https://elevenlabs.io/app/api/api-keys
ELEVENLABS_API_KEY=
# Optional. The voice for Krabby, from the ElevenLabs library.
ELEVENLABS_VOICE_ID=

# Optional. Where the web app finds the Python catalog feed.
CATALOG_API_URL=

OPENROUTER_API_KEY=
