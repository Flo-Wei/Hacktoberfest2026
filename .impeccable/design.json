  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action on a screen.",
      "html": "<button class=\"ds-btn-primary\">Let's go</button>",
      "css": ".ds-btn-primary{background:var(--primary);color:var(--primary-foreground);height:44px;padding:0 20px;border:0;border-radius:10px;font-size:15px;font-weight:500;transition:background-color .15s}.ds-btn-primary:hover{background:var(--primary-hover)}.ds-btn-primary:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary actions and the login button.",
      "html": "<button class=\"ds-btn-outline\">Create account</button>",
      "css": ".ds-btn-outline{background:var(--card);color:var(--foreground);height:44px;padding:0 20px;border:1px solid var(--border);border-radius:10px;font-size:15px;font-weight:500;transition:background-color .15s}.ds-btn-outline:hover{background:var(--accent)}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Text entry on an ivory surface.",
      "html": "<input class=\"ds-input\" placeholder=\"Your name\" />",
      "css": ".ds-input{background:var(--card);color:var(--foreground);height:44px;padding:0 12px;border:1px solid var(--input);border-radius:10px;font-size:15px}.ds-input:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Preference Chip",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "Selected preference with a check icon.",
      "html": "<span class=\"ds-chip\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6 9 17l-5-5\"/></svg>Vegan</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 14px;border:1px solid var(--selected-foreground);border-radius:9999px;background:var(--selected);color:var(--selected-foreground);font-size:14px;font-weight:500}"
    },
