  "narrative": {
    "northStar": "The Helpful Crab",
    "overview": "Grabby behaves like a clean, familiar app and sounds like a friend who knows the shelves. Everything is warm and flat, and the personality comes from one small crab rather than from decoration. People arrive to find offers, so nothing competes with that job.\n\nThe source brief is `frontend.txt`. Tokens live in `web/src/app/globals.css` and reach components through shadcn semantic names, so new UI uses `bg-primary` or `text-muted-foreground`, never raw colors.",
    "keyCharacteristics": [
      "Warm cream and ivory surfaces, with espresso text and terracotta used sparingly",
      "Inter throughout, in regular, medium and semibold",
      "Flat surfaces separated by spacing and thin borders",
      "Comfortable 44px controls and pill-shaped chips",
      "Swipe as the one highlighted feature",
      "Full-width panels that share the navbar's edges",
      "A crab that walks sideways when something is happening"
    ],
    "rules": [
      {
        "name": "The Reserved Terracotta Rule",
        "body": "Terracotta and coral mark primary actions, selection and useful emphasis only. Hover on neutral controls stays neutral.",
        "section": "colors"
      },
      {
        "name": "The Honest Status Rule",
        "body": "Color never carries status alone.",
        "section": "colors"
      },
      {
        "name": "The Shared Edge Rule",
        "body": "Content starts and ends where the navbar does. Never put a screen in a narrow centered column.",
        "section": "layout"
      },
      {
        "name": "The Earned Space Rule",
        "body": "A panel stretches only when something fills it or it holds one centered focus. Cards keep their content height, because a tall card with little in it reads as a mistake.",
        "section": "layout"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Cards and list items carry a border, not a shadow. The onboarding sheet is the one exception.",
        "section": "elevation"
      },
      {
        "name": "The One Highlight Rule",
        "body": "Swipe is the only filled item in navigation. Nothing else, including the current page, may compete with it.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use semantic tokens and existing shadcn components first.",
      "**Do** label sample data, using words like \"Test profile\" and \"Sample prices\".",
      "**Do** mark planned features with a \"Soon\" badge.",
      "**Do** write warm, everyday English such as \"What do you like to buy?\"."
    ],
    "donts": [
      "**Don't** invent discounts, prices, savings or dietary claims.",
      "**Don't** use technical words like \"mock\" in the interface.",
      "**Don't** add glass effects, heavy gradients or large decorative backgrounds. Onboarding is the single exception, chosen on purpose, and the rest of the app stays flat.",
      "**Don't** let the crab compete with offers or animate without a reason.",
      "**Don't** imply a retailer logo or product photo exists when it doesn't. Use the crab as a clean fallback, not emoji."
    ]
  }
}