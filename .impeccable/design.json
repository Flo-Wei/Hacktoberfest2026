      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;height:56px;padding:0 16px;background:var(--card);border:1px solid var(--border);border-radius:16px}.ds-links{display:flex;gap:20px}.ds-links a{font-size:14px;font-weight:500;color:var(--muted-foreground);text-decoration:none}.ds-links a:hover{color:var(--foreground);text-decoration:underline;text-underline-offset:6px}"
    }
